// XKB port of the Lego1 Windows keyboard layout.
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"

    name[Group1] = "Estonian (Lego)";

    key <TLDE> { type[Group1] = "TWO_LEVEL",
                 [ dead_grave, asciitilde ] };

    key <AE01> { [ 1, exclam, onesuperior, exclamdown ] };
    key <AE02> { [ 2, at, twosuperior, NoSymbol ] };
    key <AE03> { [ 3, numbersign, threesuperior, NoSymbol ] };
    key <AE04> { [ 4, dollar, currency, sterling ] };
    key <AE05> { [ 5, percent, EuroSign, permille ] };
    key <AE06> { [ 6, asciicircum, onequarter, NoSymbol ] };
    key <AE07> { [ 7, ampersand, onehalf, NoSymbol ] };
    key <AE08> { [ 8, asterisk, threequarters, NoSymbol ] };
    key <AE09> { [ 9, parenleft, leftsinglequotemark, NoSymbol ] };
    key <AE10> { [ 0, parenright, rightsinglequotemark, NoSymbol ] };
    key <AE11> { [ minus, underscore, yen, NoSymbol ] };
    key <AE12> { [ equal, plus, multiply, division ] };

    key <AD02> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ w, W, aring, Aring ] };
    key <AD03> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ e, E, ediaeresis, Ediaeresis ] };
    key <AD04> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ r, R, registered, NoSymbol ] };
    key <AD05> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ t, T, trademark, NoSymbol ] };
    key <AD06> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ y, Y, ydiaeresis, Ydiaeresis ] };
    key <AD07> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ u, U, udiaeresis, Udiaeresis ] };
    key <AD08> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ i, I, idiaeresis, Idiaeresis ] };
    key <AD09> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ o, O, otilde, Otilde ] };
    key <AD10> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ p, P, odiaeresis, Odiaeresis ] };
    key <AD11> { [ bracketleft, braceleft, guillemotleft, NoSymbol ] };
    key <AD12> { [ bracketright, braceright, guillemotright, NoSymbol ] };

    key <AC01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ a, A, adiaeresis, Adiaeresis ] };
    key <AC02> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ s, S, scaron, Scaron ] };
    key <AC03> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ d, D, Greek_delta, Greek_DELTA ] };
    key <AC09> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ l, L, Greek_lambda, Greek_LAMBDA ] };
    key <AC10> { [ semicolon, colon, paragraph, degree ] };
    key <AC11> { [ apostrophe, quotedbl, dead_acute, diaeresis ] };
    key <BKSL> { [ backslash, bar, notsign, brokenbar ] };

    key <AB01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC",
                 [ z, Z, zcaron, Zcaron ] };
    key <AB03> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ c, C, copyright, NoSymbol ] };
    key <AB07> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
                 [ m, M, mu, NoSymbol ] };
    key <AB08> { [ comma, less, NoSymbol, lessthanequal ] };
    key <AB09> { [ period, greater, NoSymbol, greaterthanequal ] };
    key <AB10> { [ slash, question, questiondown, NoSymbol ] };

    // Keep both the ANSI backslash key and the ISO 102nd key consistent.
    key <LSGT> { [ backslash, bar, NoSymbol, NoSymbol ] };
    key <KPDL> { [ KP_Delete, KP_Decimal ] };

    include "level3(ralt_switch)"
};
